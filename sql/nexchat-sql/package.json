{
  "name": "nexchat-sql",
  "version": "5.0.0",
  "description": "NexChat — real-time chat with SQL (SQLite/PostgreSQL/MySQL) + Sequelize + JWT + admin panel",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev":   "node --watch server/index.js"
  },
  "dependencies": {
    "bcryptjs":     "^2.4.3",
    "cors":         "^2.8.5",
    "dotenv":       "^16.4.5",
    "express":      "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer":       "^1.4.5-lts.1",
    "nodemailer":   "^6.9.13",
    "pg":           "^8.12.0",
    "pg-hstore":    "^2.3.4",
    "mysql2":       "^3.10.3",
    "sequelize":    "^6.37.3",
    "sharp":        "^0.33.4",
    "socket.io":    "^4.7.5",
    "uuid":         "^10.0.0"
  },
  "note": "For SQLite install: npm install better-sqlite3 OR sqlite3 (requires build tools). For cloud deploy use postgres or mysql dialects instead."
}
