PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/chatapp
JWT_SECRET=your_jwt_secret_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NexChat" <you@gmail.com>
RL_AUTH_MAX=10        # login/register/forgot per 15 min
RL_OTP_MAX=5          # OTP verify/reset per 15 min
RL_UPLOAD_MAX=20      # uploads per 60 min
RL_ADMIN_MAX=60       # admin writes per 15 min
RL_INVITE_MAX=20      # invite attempts per 15 min
RL_API_MAX=300        # all API calls per 15 min
RL_SOCKET_MAX=30      # socket messages per 10 seconds